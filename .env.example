# ── Vapi Web SDK (client-side; these are baked into the page bundle) ──────────
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=

# ── Links ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_DASHBOARD_LOGIN_URL=https://app.mimshakim.com/login
# Leave unset to use the built-in /demo form; set to a Calendly URL to override.
NEXT_PUBLIC_DEMO_BOOKING_URL=

# ── Where /demo submissions go (server-only; configure at least one) ──────────
# Supabase is the durable sink; Slack is the notification. Configure both.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DEMO_TABLE=demo_requests
DEMO_SLACK_WEBHOOK_URL=
# Optional extra sink (Make / Zapier / n8n).
DEMO_WEBHOOK_URL=

# ── Public web-call throttle (server-only) ───────────────────────────────────
# Guards the Vapi org concurrency limit (10) against a public dial button.
# Uses SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY above; fails open if unset.
DEMO_CALL_MAX_PER_HOUR=3
DEMO_CALL_WINDOW_MINUTES=60
# Salt for hashing visitor IPs. Set to any long random string in production.
DEMO_CALL_IP_SALT=
